# Export these in your shell; Jev-Jarvis does not load .env files automatically.
JARVIS_DECIDER=rules
JARVIS_PLANNER=rules
# Optional local Laya decisions: pip install -e '.[laya]'
# JARVIS_DECIDER=laya
# Optional hosted Jev decisions (your request is sent to TypeSafe):
# JARVIS_DECIDER=jev
# TYPESAFE_API_KEY=
JARVIS_JEV_MODEL=jev-latest
# Optional local natural-language planning; run Ollama separately.
JARVIS_OLLAMA_MODEL=qwen3:4b
# JARVIS_PLANNER=ollama
# Optional local press-to-talk: pip install -e '.[voice]'
JARVIS_VOICE=0
JARVIS_WHISPER_MODEL=base.en
